(function(){
    if(window.newdeaf_loaded) return;
    
    Lampa.Source.add({
        name: 'newdeaf',
        title: 'NewDeaf',
        protocol: 'https://',
        search: function(q,p,cb){ cb([]); },
        info: function(u,cb){ cb({}); },
        player: function(u,cb){ cb(false); }
    });
    
    window.newdeaf_loaded = true;
    console.log('[NewDeaf] Плагин загружен');
})();
