(function() {
    'use strict';
    
    if (window.newdeaf_bootstrap_loaded) return;
    
    function loadPlugin() {
        var version = Lampa.Manifest.app_digital >= 30000 ? 'v3' : 'v2';
        var url = 'https://' + window.location.hostname + '/lampa-newdeaf-plugin/' + version + '/plugin.js';
        
        Lampa.Utils.putScriptAsync(url, function() {
            console.log('[NewDeaf] Плагин версии', version, 'загружен');
        });
    }
    
    if (window.appready) {
        loadPlugin();
    } else {
        Lampa.Listener.follow('app', loadPlugin);
    }
    
    window.newdeaf_bootstrap_loaded = true;
})();
